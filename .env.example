# ============================================================================
# Archivo de ejemplo de variables de entorno.
# Copiar a ".env" y ajustar los valores antes de levantar la aplicación.
# NUNCA commitear el archivo .env real (queda ignorado por .gitignore).
# ============================================================================

# -- Servidor --------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Orígenes permitidos para CORS (separados por coma). Usar "*" sólo en dev.
CORS_ORIGINS=http://localhost:3001,http://localhost:19006

# -- MongoDB ---------------------------------------------------------------
# Cadena de conexión. En producción usar replica set y credenciales.
MONGO_URI=mongodb://localhost:27017/teg_telemedicina

# -- JWT -------------------------------------------------------------------
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambiame_por_un_secreto_muy_largo_y_aleatorio
JWT_EXPIRES_IN=1d
# Token de recuperación de contraseña (validez 24h según el alcance del TEG)
JWT_RESET_SECRET=otro_secreto_distinto_para_reset
JWT_RESET_EXPIRES_IN=24h

# -- Seguridad de cuentas --------------------------------------------------
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=3

# -- Correo (recuperación de contraseña) -----------------------------------
# En desarrollo se puede apuntar a Mailtrap, Ethereal o smtp local (MailHog).
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=usuario
MAIL_PASS=contrasena
MAIL_FROM="Plataforma Telemedicina <no-reply@telemedicina.local>"
# Base URL del frontend web, usada para construir el enlace de reset
WEB_RESET_URL=http://localhost:3001/reset-password

# -- Archivos --------------------------------------------------------------
# Tamaño máximo permitido por archivo en bytes (1 MB por especificación)
MAX_FILE_SIZE=1048576

# -- WebRTC (sólo informativo; el backend no necesita las credenciales TURN;
#    el cliente las consume. Se exponen por endpoint /ice-servers para que
#    los clientes las obtengan en runtime.) -----------------------------------
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# -- Admin seed (opcional) --------------------------------------------------
# Si están presentes, al arrancar crea un administrador inicial.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
